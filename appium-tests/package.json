{
  "name": "appium-calculator-tests",
  "version": "1.0.0",
  "description": "Appium test automation framework for iOS Calculator app",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/**/*.spec.js --timeout 120000 --reporter spec",
    "test:calculator": "mocha tests/calculator.spec.js --timeout 120000 --reporter spec",
    "test:settings": "mocha tests/settings.spec.js --timeout 120000 --reporter spec",
    "test:home": "mocha tests/home.spec.js --timeout 180000 --reporter spec",
    "test:report": "mocha tests/**/*.spec.js --timeout 120000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=test-report",
    "lint": "eslint .",
    "start:appium": "appium --relaxed-security --port 4723"
  },
  "keywords": [
    "appium",
    "ios",
    "automation",
    "testing",
    "calculator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "webdriverio": "^8.29.0",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
